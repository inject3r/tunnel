# Maintainer: Tunnel Project
pkgname=tunnel
pkgver=1.1.0
pkgrel=1
pkgdesc='Linux proxy tunnel with nftables-backed global mode'
arch=('x86_64' 'aarch64')
url='https://github.com/inject3r/tunnel'
license=('MIT')
depends=('nftables')
optdepends=('systemd: service integration')
source=()

build() {
  local root="$startdir/../.."

  cmake -S "$root" \
        -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DTUNNEL_STATIC_CXX=ON

  cmake --build "$srcdir/build" -j"$(nproc)"
}

package() {
  local root="$startdir/../.."

  DESTDIR="$pkgdir" cmake --install "$srcdir/build"

  install -Dm644 \
    "$root/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
